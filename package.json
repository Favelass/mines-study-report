{
  "name": "mines-study-report",
  "version": "1.0.0",
  "description": "A TypeScript command-line tool to analyse study sessions from CSV files.",
  "type": "module",
  "license": "MIT",
  "author": "Frederic Dardinier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Favelass/mines-study-report.git"
  },
  "homepage": "https://github.com/Favelass/mines-study-report#readme",
  "bugs": "https://github.com/Favelass/mines-study-report/issues",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.6.2",
  "bin": {
    "study-report": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/report.d.ts",
      "import": "./dist/report.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import {rmSync} from 'node:fs'; rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/cli.js",
    "prepack": "npm run build",
    "sbom": "npm sbom --sbom-format cyclonedx",
    "audit:deps": "npm audit"
  },
  "dependencies": {
    "commander": "15.0.0",
    "csv-parse": "7.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
